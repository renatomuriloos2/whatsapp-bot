# Supabase (proyecto NUEVO, solo para este portal): Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# Solo para el servidor — NUNCA con prefijo NEXT_PUBLIC_. Lo usan el webhook
# de WhatsApp y la gestión de usuarios.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Claude: console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=tu-anthropic-api-key

# WhatsApp Cloud API (developers.facebook.com → tu app → WhatsApp).
WHATSAPP_PHONE_NUMBER_ID=tu-phone-number-id
# Token permanente de un System User con whatsapp_business_messaging.
WHATSAPP_ACCESS_TOKEN=tu-token-permanente
# App settings → Basic → App secret. Verifica la firma de cada webhook.
WHATSAPP_APP_SECRET=tu-app-secret
# Valor aleatorio que también pegas en la configuración del webhook en Meta.
WHATSAPP_VERIFY_TOKEN=un-valor-aleatorio

# Opcional: búsqueda semántica con embeddings de Voyage AI (voyageai.com).
VOYAGE_API_KEY=

# Solo si tu clave de Anthropic se creó a nivel de organización (sin
# workspace) y la API pide "anthropic-workspace-id": el ID del workspace
# (console.anthropic.com → Settings → Workspaces, empieza con wrkspc_).
ANTHROPIC_WORKSPACE_ID=

# Opcional: sincronizar carpetas de Google Drive (README → "Sincronizar con
# Google Drive"). Todo el contenido del archivo JSON de la cuenta de servicio.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Alternativa: OneDrive / SharePoint (requiere un administrador de Microsoft 365).
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Protege /api/cron/sync-carpetas (la sincronización diaria). Valor aleatorio
# largo, ej. `openssl rand -hex 24`.
CRON_SECRET=

# Avisos al equipo por correo (opcional) — https://resend.com/api-keys
RESEND_API_KEY=
# Remitente; sin dominio verificado en Resend usa onboarding@resend.dev
# (solo puede enviar al correo con el que creaste la cuenta de Resend).
RESEND_FROM=
# Dirección del portal para los enlaces de los avisos (opcional en Vercel).
NEXT_PUBLIC_SITE_URL=
